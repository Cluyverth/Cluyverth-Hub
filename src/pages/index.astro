---
import Base from '../layouts/Base.astro';

const description = 'Construo sites e ferramentas para a web. Aqui você encontra meus projetos, o código por trás deles e um caderno sobre o que aprendo dentro e fora da programação.';
---

<Base title="Início" description={description} page="home">
  <section class="chapter-stage profile-stage" aria-labelledby="profile-title">
    <header class="profile-copy">
      <p class="chapter-label" lang="en">Software Engineer &amp; Creator</p>
      <h1 id="profile-title">Cluyverth<br />Pereira</h1>
      <p class="profile-lead">{description}</p>
      <div class="profile-actions">
        <a class="cta" href="/projetos/">Ver projetos</a>
        <a class="profile-contact text-link" href="mailto:contact@cluyverth.com"><span class="ink-line">Entrar em contato</span></a>
      </div>
    </header>
    <figure class="profile-art">
      <img src="/media/retrato-estudio.webp" width="2560" height="2560" fetchpriority="high" alt="Retrato ilustrado de Cluyverth Pereira, de perfil e com fones de ouvido" />
      <figcaption>@cluyverth</figcaption>
    </figure>
    <nav class="profile-social" aria-label="Perfis profissionais">
      <a href="https://github.com/Cluyverth" target="_blank" rel="noopener noreferrer" aria-label="GitHub (abre em nova aba)">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.09c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 .1.03 2.63 3.28 1.56.1-.73.39-1.23.71-1.51-2.5-.29-5.12-1.25-5.12-5.56 0-1.22.44-2.23 1.16-3.01-.12-.29-.51-1.43.11-2.98 0 0 .95-.3 3.09 1.15a10.74 10.74 0 0 1 5.62 0c2.14-1.45 3.08-1.15 3.08-1.15.62 1.55.23 2.69.11 2.98.72.78 1.16 1.79 1.16 3.01 0 4.32-2.63 5.27-5.14 5.55.41.35.77 1.03.77 2.08v2.47c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg>
      </a>
      <a href="https://www.linkedin.com/in/cluyverth/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (abre em nova aba)">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.7 2 2 2.68 2 3.52v16.96C2 21.32 2.7 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 19H4.97V9.46h2.96V19ZM6.45 8.16a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44ZM19.04 19h-2.96v-4.64c0-1.11-.02-2.53-1.55-2.53-1.55 0-1.79 1.21-1.79 2.45V19H9.78V9.46h2.84v1.3h.04a3.12 3.12 0 0 1 2.81-1.54c3 0 3.57 1.97 3.57 4.54V19Z" /></svg>
      </a>
    </nav>
  </section>
</Base>
