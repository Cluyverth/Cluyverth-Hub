---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-16 text-center">
    <h1 class="font-serif text-4xl font-semibold tracking-tight md:text-5xl">Page not found</h1>
    <p class="mt-4 text-base text-ink-muted dark:text-slate">
      This note does not exist, or was never public.
    </p>
    <a href="/" class="mt-8 inline-block font-medium text-terra hover:underline dark:text-gold">
      Back home
    </a>
  </section>
</Base>
