---
import Base from '../../layouts/Base.astro';
import { ExternalLink } from 'lucide';
import Lucide from 'astro-lucide';
import { getVisibleNotes, noteSlug } from '../../lib/notes';
import { githubMark } from '../../lib/brand-icons';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dev = import.meta.env.DEV;
const projects = (await getVisibleNotes(locale, dev)).filter((entry) => entry.data.project);
const prefix = locale === 'en' ? '' : '/pt';
---

<Base title={t(locale, 'projects.title')} locale={locale}>
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-16">
    <h1 class="font-serif text-4xl font-bold tracking-tight md:text-5xl">{t(locale, 'projects.title')}</h1>
    <p class="mt-4 max-w-xl text-base text-ink-muted dark:text-slate">
      {t(locale, 'projects.intro')}
    </p>

    {
      projects.length === 0 ? (
        <p class="mt-12 rounded-lg border border-dashed border-slate/50 p-8 text-center text-base text-ink-muted dark:text-slate">
          {t(locale, 'projects.empty')}
        </p>
      ) : (
        <ul class="mt-10">
          {
            projects.map((entry) => {
              const slug = noteSlug(entry);
              const { title, description, stack, image, repo, live } = entry.data;
              return (
                <li class="border-b border-slate/40">
                  <div class="group relative block pt-6 pb-8 sm:min-h-[230px] sm:pb-0">
                    <span class="relative z-10 block sm:w-[min(64%,720px)]">
                      <a href={`${prefix}/projects/${slug}`}>
                        <h2 class="font-serif text-2xl font-bold tracking-tight text-ink transition-colors group-hover:text-terra dark:text-paper dark:group-hover:text-gold">
                          {title}
                        </h2>
                      </a>
                      {
                        stack.length > 0 && (
                          <p class="mt-2 flex flex-wrap gap-x-2 text-sm font-semibold text-terra dark:text-gold">
                            {stack.map((tech) => <span>{tech}</span>)}
                          </p>
                        )
                      }
                      {description && (
                        <p class="mt-2 max-w-3xl text-base leading-relaxed text-ink-muted dark:text-slate">
                          {description}
                        </p>
                      )}
                      {
                        (repo || live) && (
                          <div class="mt-5 flex flex-wrap gap-2">
                            {
                              live && (
                                <a
                                  href={live}
                                  target="_blank"
                                  rel="noopener"
                                  class="inline-flex items-center gap-1.5 rounded-full bg-terra px-4 py-1.5 text-sm font-semibold text-paper transition-colors hover:bg-terra/90 dark:bg-gold dark:text-ink dark:hover:bg-gold/90"
                                >
                                  <Lucide icon={ExternalLink} class="size-3.5" />
                                  {t(locale, 'projects.live')}
                                </a>
                              )
                            }
                            {
                              repo && (
                                <a
                                  href={repo}
                                  target="_blank"
                                  rel="noopener"
                                  class="inline-flex items-center gap-1.5 rounded-full border border-slate/40 px-4 py-1.5 text-sm font-semibold text-ink-muted transition-colors hover:border-terra hover:text-terra dark:text-slate dark:hover:border-gold dark:hover:text-gold"
                                >
                                  <Lucide icon={githubMark} class="size-3.5" />
                                  {t(locale, 'projects.source')}
                                </a>
                              )
                            }
                          </div>
                        )
                      }
                    </span>
                    {
                      image && (
                        <div class="cover-wash absolute bottom-0 right-0 top-6 z-0 hidden sm:block">
                          <img src={image} alt="" loading="lazy" class="h-full w-full object-cover" />
                        </div>
                      )
                    }
                  </div>
                </li>
              );
            })
          }
        </ul>
      )
    }
  </section>
</Base>
