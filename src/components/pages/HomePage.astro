---
import Base from '../../layouts/Base.astro';
import { BookOpen, FolderKanban, Link2, Mail, Network, UserRound } from 'lucide';
import Lucide from 'astro-lucide';
import { githubMark, linkedinMark } from '../../lib/brand-icons';
import { localePrefix, t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Mobile-only quick navigation: lets visitors reach the other pages from the
// home screen without opening the hamburger menu.
const quickNav = [
  { href: `${localePrefix(locale)}/vault`, label: t(locale, 'nav.vault'), icon: BookOpen },
  { href: `${localePrefix(locale)}/projects`, label: t(locale, 'nav.projects'), icon: FolderKanban },
  { href: `${localePrefix(locale)}/graph`, label: t(locale, 'nav.graph'), icon: Network },
  { href: `${localePrefix(locale)}/about`, label: t(locale, 'nav.about'), icon: UserRound },
  { href: `${localePrefix(locale)}/links`, label: t(locale, 'nav.links'), icon: Link2, wide: true },
];
---

<Base locale={locale}>
  <section class="mx-auto max-w-6xl px-6 pt-8 pb-16 wide:pt-16">
    <div class="wide:grid wide:grid-cols-[minmax(0,1fr)_auto] wide:items-start wide:gap-12 xl:gap-20">
      <div class="hidden max-w-3xl wide:block">
        <h1 class="text-6xl font-bold leading-tight tracking-tight md:text-7xl">
          <span class="block">Cluyverth</span>
          <span class="block pl-8 text-terra dark:text-gold md:pl-48">Hub</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted dark:text-slate">
          {t(locale, 'hero.motto')}
        </p>
      </div>

      <div class="mid:grid mid:grid-cols-[minmax(0,1fr)_auto] mid:items-center mid:gap-10">
        <aside class="mt-0 flex flex-col items-center text-center wide:-mr-6 wide:mt-2 wide:items-end wide:text-right">
        <img
          src="/avatar.webp"
          alt="Cluyverth Pereira"
          width="160"
          height="160"
          loading="eager"
          class="size-40 rounded-full border border-slate/40 object-cover"
        />
        <p class="mt-4 text-base font-semibold">Cluyverth Pereira</p>
        <p class="text-sm text-ink-muted dark:text-slate">@cluyverth</p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-base wide:justify-end">
          <a
            href="https://github.com/Cluyverth"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 font-medium text-ink-muted transition-colors hover:text-terra dark:text-slate dark:hover:text-gold"
          >
            <Lucide icon={githubMark} class="size-4 text-terra dark:text-gold" />
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/cluyverth/"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 font-medium text-ink-muted transition-colors hover:text-terra dark:text-slate dark:hover:text-gold"
          >
            <Lucide icon={linkedinMark} class="size-4 text-terra dark:text-gold" />
            LinkedIn
          </a>
          <button
            id="copy-email"
            type="button"
            class="inline-flex cursor-pointer items-center gap-2 font-medium text-ink-muted transition-colors hover:text-terra dark:text-slate dark:hover:text-gold"
          >
            <Lucide icon={Mail} class="size-4 text-terra dark:text-gold" />
            <span data-copy-label>Email</span>
          </button>
        </div>
        <p class="mt-3 max-w-[19rem] text-center text-base italic leading-relaxed text-ink-muted dark:text-slate wide:text-right">
          &quot;{t(locale, 'hero.quote')}&quot; <span class="whitespace-nowrap text-sm not-italic">- {t(locale, 'hero.seneca')}</span>
        </p>
      </aside>

      <nav class="mt-8 grid grid-cols-2 gap-3 wide:hidden mid:mt-0 mid:w-64 mid:grid-cols-1" aria-label="Site navigation">
      {
        quickNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-3 rounded-xl border border-slate/50 bg-paper-deep/30 px-4 py-3.5 font-semibold text-ink transition-colors hover:border-terra hover:text-terra dark:bg-ink-soft/30 dark:text-paper dark:hover:border-gold dark:hover:text-gold',
              item.wide ? 'col-span-2 mid:col-span-1' : undefined,
            ]}
          >
            <Lucide icon={item.icon} class="size-5 shrink-0 text-terra dark:text-gold" />
            {item.label}
          </a>
        ))
      }
      </nav>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  document.getElementById('copy-email')?.addEventListener('click', async () => {
    const email = 'contact@cluyverth.com';
    const label = document.querySelector('[data-copy-label]');
    try {
      await navigator.clipboard.writeText(email);
      if (label) {
        label.textContent = 'Copied!';
        setTimeout(() => {
          label.textContent = 'Email';
        }, 1500);
      }
    } catch {
      if (label) label.textContent = email;
    }
  });
</script>
