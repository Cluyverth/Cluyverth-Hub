---
import LucideIcon from './LucideIcon.astro';

interface Props {
  title: string;
  repository: string;
  live: string;
}

const { title, repository, live } = Astro.props;
---

<div class="work-actions">
  <a href={repository} aria-label={`GitHub: ${title}`}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.09c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1.01 1.72 2.64 1.22 3.29.93.1-.73.39-1.23.71-1.51-2.5-.29-5.12-1.25-5.12-5.56 0-1.22.44-2.23 1.16-3.01-.12-.29-.51-1.44.11-3.01 0 0 .95-.3 3.09 1.15a10.74 10.74 0 0 1 5.62 0c2.14-1.45 3.09-1.15 3.09-1.15.62 1.57.23 2.72.11 3.01.72.78 1.15 1.79 1.15 3.01 0 4.32-2.63 5.27-5.14 5.55.41.35.77 1.03.77 2.08v3.08c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg>
    <span class="ink-line">GitHub</span>
  </a>
  <a class="cta" href={live} aria-label={`Ao vivo: ${title}`}>
    <LucideIcon name="square-arrow-out-up-right" />
    Ao vivo
  </a>
</div>
