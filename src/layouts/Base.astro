---
import '../styles/global.css';
import { ArrowUp, Menu, Moon, Rss, Sun, X } from 'lucide';
import Lucide from 'astro-lucide';
import { localePrefix, t, type Locale } from '../lib/i18n';

interface Props {
  title?: string;
  locale?: Locale;
}

const { title = 'Cluyverth Hub', locale = 'en' } = Astro.props;
const nav = [
  { href: `${localePrefix(locale)}/`, label: t(locale, 'nav.home') },
  { href: `${localePrefix(locale)}/vault`, label: t(locale, 'nav.vault') },
  { href: `${localePrefix(locale)}/projects`, label: t(locale, 'nav.projects') },
  { href: `${localePrefix(locale)}/graph`, label: t(locale, 'nav.graph') },
  { href: `${localePrefix(locale)}/about`, label: t(locale, 'nav.about') },
  { href: `${localePrefix(locale)}/links`, label: t(locale, 'nav.links') },
];
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
// Language toggle: the same path in each locale, prefixed for Portuguese.
const unprefixed = pathname.replace(/^\/pt(?=\/|$)/, '') || '/';
const ptHref = `/pt${unprefixed === '/' ? '' : unprefixed}`;
const enHref = unprefixed === '/' ? '/' : unprefixed;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="My notes, projects and links. A public slice of my Obsidian vault." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Vault RSS" href={`${localePrefix(locale)}/rss.xml`} />
    <script is:inline>
      // Apply theme before paint to avoid a flash of the wrong theme.
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-paper font-sans text-ink antialiased transition-colors dark:bg-ink dark:text-paper">
    <header class="sticky top-0 z-40 w-full bg-paper dark:bg-ink">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between border-b border-slate/40 px-6 py-5 nav:grid nav:grid-cols-[1fr_auto_1fr]">
        <a href={`${localePrefix(locale)}/`} aria-label="Cluyverth Hub, home" class="justify-self-start">
          <span class="logo-mark">CP</span>
        </a>
        <nav class="hidden items-center gap-6 text-sm nav:flex">
          {
            nav.map((item) => {
              const active =
                item.href === `${localePrefix(locale)}/`
                  ? pathname === item.href
                  : pathname === item.href || pathname.startsWith(`${item.href}/`);
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={['nav-link', active ? 'nav-link-active' : undefined]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <div class="hidden items-center justify-self-end gap-2 nav:flex">
          <div
            class="flex items-center gap-1 text-sm font-bold"
            role="group"
            aria-label="Language"
          >
            <a
              href={ptHref}
              aria-label="Português (Brasil)"
              class:list={['px-0.5 transition-colors', locale === 'pt' ? 'lang-active' : 'lang-inactive']}
            >
              PT
            </a>
            <span class="text-slate/50">|</span>
            <a
              href={enHref}
              aria-label="English"
              class:list={['px-0.5 transition-colors', locale === 'en' ? 'lang-active' : 'lang-inactive']}
            >
              EN
            </a>
          </div>
          <div class="flex items-center gap-1">
            <button
              type="button"
              aria-label="Toggle color theme"
              class="theme-toggle theme-toggle-btn"
            >
              <Lucide icon={Moon} class="theme-icon-moon size-4" />
              <Lucide icon={Sun} class="theme-icon-sun size-4" />
            </button>
          </div>
        </div>
        <div class="flex items-center gap-1.5 nav:hidden">
          <div class="flex items-center gap-1 text-sm font-bold" role="group" aria-label="Language">
            <a
              href={ptHref}
              aria-label="Português (Brasil)"
              class:list={['px-0.5 transition-colors', locale === 'pt' ? 'lang-active' : 'lang-inactive']}
            >
              PT
            </a>
            <span class="text-slate/50">|</span>
            <a
              href={enHref}
              aria-label="English"
              class:list={['px-0.5 transition-colors', locale === 'en' ? 'lang-active' : 'lang-inactive']}
            >
              EN
            </a>
          </div>
          <button
            type="button"
            aria-label="Toggle color theme"
            class="theme-toggle theme-toggle-btn"
          >
            <Lucide icon={Moon} class="theme-icon-moon size-4" />
            <Lucide icon={Sun} class="theme-icon-sun size-4" />
          </button>
          <button
            id="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="grid size-9 place-items-center rounded-md text-ink transition-colors hover:text-terra dark:text-paper dark:hover:text-gold"
          >
            <Lucide icon={Menu} class="size-5" />
          </button>
        </div>
      </div>
    </header>
    <nav
      id="mobile-menu"
      class="menu-panel fixed inset-0 z-[60] hidden flex-col overflow-y-auto bg-paper nav:hidden dark:bg-ink"
      aria-label="Mobile navigation"
    >
      <div class="flex items-center justify-between px-6 py-5">
        <span class="logo-mark">CP</span>
        <button
          id="menu-close"
          type="button"
          aria-label="Close menu"
          class="grid size-9 place-items-center rounded-md text-ink transition-colors hover:text-terra dark:text-paper dark:hover:text-gold"
        >
          <Lucide icon={X} class="size-5" />
        </button>
      </div>
      <ul class="flex flex-1 flex-col items-center justify-center gap-1 px-6 pb-20">
        {
          nav.map((item) => {
            const active =
              item.href === `${localePrefix(locale)}/`
                ? pathname === item.href
                : pathname === item.href || pathname.startsWith(`${item.href}/`);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-4 py-2.5 text-2xl font-bold transition-colors',
                    active
                      ? 'text-terra dark:text-gold'
                      : 'text-ink-muted hover:text-terra dark:text-slate dark:hover:text-gold',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <main class="pb-32">
      <slot />
    </main>
    <footer class="fixed inset-x-0 bottom-0 z-40 bg-paper dark:bg-ink">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 border-t border-slate/40 px-6 py-8 text-base text-ink-muted dark:text-slate">
        <span>© {year} Cluyverth Pereira</span>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline">RSS</span>
          <a
            href={`${localePrefix(locale)}/rss.xml`}
            aria-label="RSS feed of public notes"
            class="grid size-8 place-items-center rounded-md text-ink-muted transition-colors hover:text-terra dark:text-slate dark:hover:text-gold"
          >
            <Lucide icon={Rss} class="size-4" />
          </a>
        </div>
      </div>
    </footer>
    <button
      id="scroll-top"
      type="button"
      aria-label="Back to top"
      class="scroll-top"
    >
      <Lucide icon={ArrowUp} class="size-4" />
    </button>
    <script is:inline>
      // Theme toggle: works on both the desktop and the mobile menu buttons.
      document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const dark = root.classList.toggle('dark');
          root.style.colorScheme = dark ? 'dark' : 'light';
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        });
      });
    </script>
    <script is:inline>
      // Mobile menu: the hamburger opens a full-screen overlay; the close
      // button, Escape and a resize back to desktop all dismiss it.
      const menuToggle = document.getElementById('menu-toggle');
      const menuClose = document.getElementById('menu-close');
      const mobileMenu = document.getElementById('mobile-menu');
      if (menuToggle && menuClose && mobileMenu) {
        const setMenuOpen = (open) => {
          mobileMenu.classList.toggle('hidden', !open);
          mobileMenu.classList.toggle('flex', open);
          menuToggle.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
        };
        menuToggle.addEventListener('click', () => setMenuOpen(true));
        menuClose.addEventListener('click', () => setMenuOpen(false));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenuOpen(false);
        });
        matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
          if (event.matches) setMenuOpen(false);
        });
      }
    </script>
    <script>
      const scrollTop = document.getElementById('scroll-top');
      if (scrollTop) {
        const onScroll = (): void => {
          scrollTop.dataset.visible = String(window.scrollY > 300);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        scrollTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
