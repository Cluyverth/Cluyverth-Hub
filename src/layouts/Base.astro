---
import '../styles/global.css';
import { ArrowUp, Menu, Moon, Rss, Sun, X } from 'lucide';
import Lucide from 'astro-lucide';
import { localePrefix, t, type Locale } from '../lib/i18n';

interface Props {
  title?: string;
  locale?: Locale;
}

const { title = 'Cluyverth Hub', locale = 'en' } = Astro.props;
const nav = [
  { href: `${localePrefix(locale)}/`, label: t(locale, 'nav.home') },
  { href: `${localePrefix(locale)}/vault`, label: t(locale, 'nav.vault') },
  { href: `${localePrefix(locale)}/projects`, label: t(locale, 'nav.projects') },
  { href: `${localePrefix(locale)}/graph`, label: t(locale, 'nav.graph') },
  { href: `${localePrefix(locale)}/about`, label: t(locale, 'nav.about') },
  { href: `${localePrefix(locale)}/links`, label: t(locale, 'nav.links') },
];
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
// Language toggle: the same path in each locale, prefixed for Portuguese.
const unprefixed = pathname.replace(/^\/pt(?=\/|$)/, '') || '/';
const ptHref = `/pt${unprefixed === '/' ? '' : unprefixed}`;
const enHref = unprefixed === '/' ? '/' : unprefixed;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="My notes, projects and links. A public slice of my Obsidian vault." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Vault RSS" href={`${localePrefix(locale)}/rss.xml`} />
    <script is:inline>
      // Apply theme before paint to avoid a flash of the wrong theme.
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-paper font-sans text-ink antialiased transition-colors dark:bg-ink dark:text-paper">
    <header class="mx-auto w-full max-w-6xl border-b border-slate/40">
      <div class="flex items-center justify-between px-6 py-5">
        <a href={`${localePrefix(locale)}/`} aria-label="Cluyverth Hub, home">
          <span class="logo-mark">CP</span>
        </a>
        <nav class="hidden items-center gap-6 text-sm md:flex">
          {
            nav.map((item) => {
              const active =
                item.href === `${localePrefix(locale)}/`
                  ? pathname === item.href
                  : pathname === item.href || pathname.startsWith(`${item.href}/`);
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={['nav-link', active ? 'nav-link-active' : undefined]}
                >
                  {item.label}
                </a>
              );
            })
          }
          <div
            class="flex items-center gap-1 text-sm font-bold"
            role="group"
            aria-label="Language"
          >
            <a
              href={ptHref}
              aria-label="Português (Brasil)"
              class:list={['px-0.5 transition-colors', locale === 'pt' ? 'lang-active' : 'lang-inactive']}
            >
              PT
            </a>
            <span class="text-slate/50">|</span>
            <a
              href={enHref}
              aria-label="English"
              class:list={['px-0.5 transition-colors', locale === 'en' ? 'lang-active' : 'lang-inactive']}
            >
              EN
            </a>
          </div>
          <div class="flex items-center gap-1">
            <button
              type="button"
              aria-label="Toggle color theme"
              class="theme-toggle theme-toggle-btn"
            >
              <Lucide icon={Moon} class="theme-icon-moon size-4" />
              <Lucide icon={Sun} class="theme-icon-sun size-4" />
            </button>
          </div>
        </nav>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="grid size-9 place-items-center rounded-md text-ink transition-colors hover:text-terra md:hidden dark:text-paper dark:hover:text-gold"
        >
          <Lucide icon={Menu} class="menu-icon-open size-5" />
          <Lucide icon={X} class="menu-icon-close hidden size-5" />
        </button>
      </div>
      <nav
        id="mobile-menu"
        class="hidden border-t border-slate/40 px-6 py-4 md:hidden"
        aria-label="Mobile navigation"
      >
        <ul class="space-y-1">
          {
            nav.map((item) => {
              const active =
                item.href === `${localePrefix(locale)}/`
                  ? pathname === item.href
                  : pathname === item.href || pathname.startsWith(`${item.href}/`);
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'block rounded-md px-3 py-2 text-base font-medium transition-colors',
                      active
                        ? 'text-terra dark:text-gold'
                        : 'text-ink-muted hover:text-terra dark:text-slate dark:hover:text-gold',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="mt-4 flex items-center justify-between border-t border-slate/40 pt-4">
          <div class="flex items-center gap-1 text-sm font-bold" role="group" aria-label="Language">
            <a
              href={ptHref}
              aria-label="Português (Brasil)"
              class:list={['px-0.5 transition-colors', locale === 'pt' ? 'lang-active' : 'lang-inactive']}
            >
              PT
            </a>
            <span class="text-slate/50">|</span>
            <a
              href={enHref}
              aria-label="English"
              class:list={['px-0.5 transition-colors', locale === 'en' ? 'lang-active' : 'lang-inactive']}
            >
              EN
            </a>
          </div>
          <button
            type="button"
            aria-label="Toggle color theme"
            class="theme-toggle theme-toggle-btn"
          >
            <Lucide icon={Moon} class="theme-icon-moon size-4" />
            <Lucide icon={Sun} class="theme-icon-sun size-4" />
          </button>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mx-auto mt-24 w-full max-w-6xl border-t border-slate/40">
      <div class="flex items-center justify-between gap-4 px-6 py-8 text-base text-ink-muted dark:text-slate">
        <span>© {year} Cluyverth Pereira</span>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline">RSS</span>
          <a
            href={`${localePrefix(locale)}/rss.xml`}
            aria-label="RSS feed of public notes"
            class="grid size-8 place-items-center rounded-md text-ink-muted transition-colors hover:text-terra dark:text-slate dark:hover:text-gold"
          >
            <Lucide icon={Rss} class="size-4" />
          </a>
        </div>
      </div>
    </footer>
    <button
      id="scroll-top"
      type="button"
      aria-label="Back to top"
      class="scroll-top"
    >
      <Lucide icon={ArrowUp} class="size-4" />
    </button>
    <script is:inline>
      // Theme toggle: works on both the desktop and the mobile menu buttons.
      document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const dark = root.classList.toggle('dark');
          root.style.colorScheme = dark ? 'dark' : 'light';
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        });
      });
    </script>
    <script is:inline>
      // Mobile menu: the hamburger toggles the panel and swaps the icon.
      const menuToggle = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      if (menuToggle && mobileMenu) {
        menuToggle.addEventListener('click', () => {
          const willOpen = mobileMenu.classList.contains('hidden');
          mobileMenu.classList.toggle('hidden', !willOpen);
          menuToggle.setAttribute('aria-expanded', String(willOpen));
          menuToggle.querySelector('.menu-icon-open')?.classList.toggle('hidden', willOpen);
          menuToggle.querySelector('.menu-icon-close')?.classList.toggle('hidden', !willOpen);
        });
      }
    </script>
    <script>
      const scrollTop = document.getElementById('scroll-top');
      if (scrollTop) {
        const onScroll = (): void => {
          scrollTop.dataset.visible = String(window.scrollY > 300);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        scrollTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
